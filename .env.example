# Supabase — banco central do dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Nunca renomear para NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Criptografia dos segredos guardados em projects (AES-256-GCM).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=

# Monitoramento — exigido no header Authorization de /api/cron/check-status
CRON_SECRET=

# Alertas de licenca (opcional; sem isso o aviso so aparece no dashboard)
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

NEXT_PUBLIC_APP_URL=http://localhost:3000
